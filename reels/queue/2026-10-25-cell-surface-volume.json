    {
     "make": "shape",
     "name": "inside",
     "kind": "circle",
     "radius": 1.15,
     "center": [
      0,
      2.4
     ],
     "color": "teal",
     "fill": 0.35
    }
   ]
  },
  {
   "text": "For a sphere of radius $r$, here are the two quantities.",
   "do": [
    {
     "make": "tex",
     "name": "A",
     "tex": [
      "A",
      "=",
      "4\\pi r^2"
