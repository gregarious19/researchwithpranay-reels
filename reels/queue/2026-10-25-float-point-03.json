     "side": "down",
     "buff": 0.8,
     "color": "green"
    }
   ]
  },
  {
   "text": "But the stored 0.1 and 0.2 were both a bit too big. Their exact sum lands here.",
   "do": [
    {
     "make": "dot",
     "name": "S",
     "on": "NL",
     "at": [
      0,
      0
     ],
     "color": "yellow"
    },
