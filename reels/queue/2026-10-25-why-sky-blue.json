     "side": "down",
     "buff": 0.4,
     "colors": {
      "0": "yellow"
     }
    }
   ]
  },
  {
   "text": "For particles that small, Lord Rayleigh worked out how strongly light gets scattered:",
   "do": [
    {
     "make": "tex",
