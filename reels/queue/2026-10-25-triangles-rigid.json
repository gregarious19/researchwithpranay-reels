{
 "id": "2026-10-25-triangles-rigid",
 "topic": "why trusses use triangles (Maxwell's counting rule, 2j-3 bars)",
 "subject": "engineering",
 "hook_type": "myth bust",
 "caption": "A pin-jointed square folds flat without any beam stretching; a triangle can't move at all. Counting says why: a frame with j joints needs 2j − 3 bars to be rigid, so a square (4 joints, 4 bars) is one short. One diagonal fixes it.\n\nSave this for your next statics exam.\n\n#engineering #civilengineering #structuralengineering #statics #truss #mechanics #stem #math",
 "cover_at": 1.0,
 "hook": "Four strong steel beams don't make a strong square.",
 "sub": "That's why bridges use triangles.",
 "beats": [
  {
   "text": "Here's a square frame: four steel beams, pinned at the corners so they can pivot.",
   "do": [
    {
     "make": "plane",
     "name": "P",
     "range": [
      -1,
      5
     ],
     "y_range": [
      -1,
      4
     ],
     "size": 7.2,
     "at": [
      0,
      1.6
     ]
    },
    {
     "make": "shape",
     "name": "sq",
     "kind": "polygon",
     "on": "P",
     "points": [
      [
       1,
       0
      ],
      [
       3,
       0
      ],
      [
       3,
       2
      ],
      [
       1,
       2
      ]
     ],
     "color": "blue"
    },
    {
     "make": "shape",
     "name": "sq2",
     "kind": "polygon",
     "on": "P",
     "points": [
      [
       1,
       0
      ],
      [
       3,
       0
      ],
      [
       4.147,
       1.638
      ],
      [
       2.147,
       1.638
      ]
     ],
     "color": "red",
     "hidden": true
    },
    {
     "make": "shape",
     "name": "sq3",
     "kind": "polygon",
     "on": "P",
     "points": [
      [
       1,
       0
      ],
      [
       3,
       0
      ],
      [
       4.813,
       0.845
      ],
      [
       2.813,
       0.845
      ]
     ],
     "color": "red",
     "hidden": true
    }
   ]
  },
  {
   "text": "Push the top sideways. No beam stretches or bends, and yet the shape gives way.",
   "do": [
    {
     "sfx": "whoosh"
    },
    {
     "transform": "sq",
     "into": "sq2",
     "time": 1.6
    },
    {
     "sfx": "thud"
    }
   ]
  },
  {
   "text": "It keeps folding, almost flat. Every side is still exactly the same length.",
   "do": [
    {
     "transform": "sq2",
     "into": "sq3",
     "time": 1.6
    },
    {
     "make": "text",
     "name": "same",
     "text": "all sides unchanged",
     "size": 52,
     "color": "red",
     "at": [
      0,
      -2.2
     ]
    }
   ]
  },
  {
   "do": [
    {
     "clear": true
    }
   ]
  },
  {
   "text": "Now a triangle: three beams, pinned the same way.",
   "do": [
    {
     "make": "plane",
     "name": "Q",
     "range": [
      -1,
      5
     ],
     "y_range": [
      -1,
      4
     ],
     "size": 7.2,
     "at": [
      0,
      1.6
     ]
    },
    {
     "make": "shape",
     "name": "tri",
     "kind": "polygon",
     "on": "Q",
     "points": [
      [
       1,
       0
      ],
      [
       3,
       0
      ],
      [
       2,
       1.732
      ]
     ],
     "color": "teal"
    }
   ]
  },
  {
   "text": "Push it and nothing moves. Three side lengths allow exactly one triangle.",
   "do": [
    {
     "indicate": "tri",
     "color": "teal"
    },
    {
     "make": "text",
     "name": "sss",
     "text": "3 lengths, 1 shape",
     "size": 56,
     "color": "teal",
     "at": [
      0,
      -2.2
     ]
    }
   ]
  },
  {
   "do": [
    {
     "clear": true
    }
   ]
  },
  {
   "text": "Count freedoms. Each joint moves in 2 directions, and 3 motions just slide or turn the whole frame.",
   "do": [
    {
     "make": "tex",
     "name": "rule",
     "tex": [
      "\\text{bars needed}",
      "=",
      "2j - 3"
     ],
     "size": 76,
     "at": [
      0,
      4.2
     ],
     "colors": {
      "2": "yellow"
     }
    }
   ]
  },
  {
   "text": "Triangle: 3 joints need $2\\cdot 3 - 3 = 3$ bars. It has 3.",
   "do": [
    {
     "make": "tex",
     "name": "t3",
     "tex": [
      "\\text{triangle:}",
      "\\;2\\cdot 3-3 = 3",
      "\\;\\checkmark"
     ],
     "size": 68,
     "next_to": "rule",
     "side": "down",
     "buff": 0.9,
     "colors": {
      "0": "teal",
      "2": "green"
     }
    }
   ]
  },
  {
   "text": "Square: 4 joints need $2\\cdot 4 - 3 = 5$ bars. It has only 4, one short: that's the fold.",
   "do": [
    {
     "sfx": "riser"
    },
    {
     "make": "tex",
     "name": "s4",
     "tex": [
      "\\text{square:}",
      "\\;2\\cdot 4-3 = 5",
      "\\;>\\;4"
     ],
     "size": 68,
     "next_to": "t3",
     "side": "down",
     "buff": 0.6,
     "colors": {
      "0": "blue",
      "2": "red"
     }
    }
   ]
  },
  {
   "do": [
    {
     "hide": [
      "t3"
     ]
    },
    {
     "move": "rule",
     "to": [
      0,
      5.3
     ],
     "scale": 0.6
    },
    {
     "move": "s4",
     "to": [
      0,
      4.4
     ],
     "scale": 0.7
    }
   ]
  },
  {
   "text": "Add the fifth bar, a diagonal. The square becomes two triangles, and it's rigid.",
   "do": [
    {
     "make": "plane",
     "name": "R",
     "range": [
      -1,
      5
     ],
     "y_range": [
      -1,
      3
     ],
     "size": 6.0,
     "at": [
      0,
