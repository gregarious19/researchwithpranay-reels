     ]
    },
    {
     "make": "shape",
     "name": "sqb",
     "kind": "polygon",
     "on": "R",
     "points": [
      [
       1,
       0
      ],
      [
       3,
       0
      ],
      [
       3,
       2
      ],
      [
       1,
       2
      ]
     ],
     "color": "blue"
    },
    {
     "make": "line",
     "name": "diag",
     "on": "R",
     "from": [
      1,
      0
     ],
     "to": [
      3,
      2
     ],
     "color": "green",
     "width": 6
    },
    {
     "sfx": "ding"
    },
    {
     "make": "group",
     "name": "braced",
     "of": [
      "sqb",
      "diag"
     ]
    },
    {
     "make": "box",
     "name": "bb",
     "around": "braced",
     "color": "green"
    }
   ]
  },
  {
   "text": "That's why cranes, roofs and bridges are built from triangles.",
   "do": [
    {
     "hide": "bb",
     "time": 0.3
    },
    {
     "wiggle": "braced"
    },
    {
     "make": "text",
